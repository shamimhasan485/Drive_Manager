# OPTIONAL. Drive Manager needs no configuration file: on first run it creates its own
# encryption key and database in ./data, and an admin sets cloud keys, the web address
# and storage options in the app under Settings (gear icon, bottom left).
# Values here only act as defaults for those settings, which is handy for Docker deploys.

# DM_SECRET_KEY=          # default: generated in data/secret.key (back up the data folder)
# DM_PUBLIC_URL=https://files.example.com
# DM_COOKIE_SECURE=true
# DM_DATA_DIR=./data       # database, secret key and server-folder storage

# Default folder for "Server folder" drives (default: <data dir>/storage)
# DM_LOCAL_ROOT=/srv/drive-manager/storage

# Google Drive: console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
# Authorized redirect URI: ${DM_PUBLIC_URL}/api/accounts/oauth/gdrive/callback
# DM_GOOGLE_CLIENT_ID=
# DM_GOOGLE_CLIENT_SECRET=

# Dropbox / Box (milestone M3)
# DM_DROPBOX_APP_KEY=
# DM_DROPBOX_APP_SECRET=
# DM_BOX_CLIENT_ID=
# DM_BOX_CLIENT_SECRET=
