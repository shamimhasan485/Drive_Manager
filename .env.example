# Copy to .env and fill in. Never commit .env.
DM_SECRET_KEY=            # python -m app.security genkey  (encrypts stored cloud tokens; keep it safe)
DM_PUBLIC_URL=https://files.example.com
DM_COOKIE_SECURE=true
DM_DATABASE_URL=sqlite+aiosqlite:///./data/drive_manager.db

# Optional: expose a folder on the server as a drive (also handy for development)
# DM_LOCAL_ROOT=/srv/drive-manager/storage

# Google Drive: console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
# Authorized redirect URI: ${DM_PUBLIC_URL}/api/accounts/oauth/gdrive/callback
DM_GOOGLE_CLIENT_ID=
DM_GOOGLE_CLIENT_SECRET=

# Dropbox / Box (milestone M3)
DM_DROPBOX_APP_KEY=
DM_DROPBOX_APP_SECRET=
DM_BOX_CLIENT_ID=
DM_BOX_CLIENT_SECRET=
